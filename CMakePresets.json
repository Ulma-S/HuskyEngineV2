{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "Visual Studio 2022 のソリューションを build/vs2022 に生成する",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022"
    },
    {
      "name": "vs2022-asan",
      "inherits": "vs2022",
      "displayName": "Visual Studio 2022 (x64) + AddressSanitizer",
      "description": "ASan を有効にしたソリューションを build/vs2022-asan に生成する(普段のビルドとはフォルダを分ける)",
      "binaryDir": "${sourceDir}/build/vs2022-asan",
      "cacheVariables": {
        "HUSKY_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "vs2022-static",
      "inherits": "vs2022",
      "displayName": "Visual Studio 2022 (x64) + 静的リンク(製品用)",
      "description": "エンジンを DLL にせず、exe に静的リンクする(製品用。HR-1)。build/vs2022-static に生成する",
      "binaryDir": "${sourceDir}/build/vs2022-static",
      "cacheVariables": {
        "HUSKY_ENGINE_SHARED": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan",
      "configurePreset": "vs2022-asan",
      "configuration": "Debug"
    },
    {
      "name": "ship",
      "displayName": "Release(静的リンク、製品用)",
      "configurePreset": "vs2022-static",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug のテスト",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "displayName": "Release のテスト",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan のテスト",
      "configurePreset": "vs2022-asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
